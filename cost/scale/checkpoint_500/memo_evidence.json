    {
      "issue_id": "usability-ads",
      "reviews": [
        {
          "review_id": "11ad400f-4487-4dfa-a9da-c8d624f4f107",
          "excerpt": "This app is very very frustrating, you only get 6 skips a day, you can't pick the song you want from your playlist, you can't skip forward it's absolutely ridiculous getting premium is the only way you could actually enjoy this app it's absolutely garbage and whenever I try and search for a song I click on it I get 5 ads then after the ads I don't even get the song I wanted.",
          "excerpt_only": false,
          "topic": "usability",
          "intent": "complaint",
          "severity": 3
        },
        {
          "review_id": "3bfefa06-133c-419b-a435-1fea919d6a44",
          "excerpt": "WAY too many ads, I used a stopwatch and found that I got 10 minutes of music and 4 of ads, this is ridiculous. The only reasonable premium plans are for multiple people or students.",
          "excerpt_only": false,
          "topic": "usability",
          "intent": "complaint",
          "severity": 3
        },
        {
          "review_id": "50626053-301c-42fa-91aa-2f88aef82e64",
          "excerpt": "I say it's great for music but the ads is unbearable not only it's unskippable it's all 25+ sec long and you get 2 ads and when you want to choose a song in your playlist your getting another ad so shuffle is the only option here and I don't understand why would you need to pay to play songs in order aren't you earning enough Spotify?",
          "excerpt_only": false,
          "topic": "usability",
          "intent": "complaint",
          "severity": 3
        }
      ]
    },
    {
      "issue_id": "playback-failure",
